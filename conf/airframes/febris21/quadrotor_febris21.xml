<!DOCTYPE airframe SYSTEM "../airframe.dtd">

<!-- this is a quadrotor frame equiped with
     * Autopilot:   Lisa/M 2.0             http://wiki.paparazziuav.org/wiki/Lisa/M_v20
     * IMU:         Aspirin 2.2            http://wiki.paparazziuav.org/wiki/AspirinIMU
     * Actuators:   PWM motor controllers  http://wiki.paparazziuav.org/wiki/Subsystem/actuators#PWM_Supervision
     * GPS:         Ublox                  http://wiki.paparazziuav.org/wiki/Subsystem/gps
     * RC:          two Spektrum sats      http://wiki.paparazziuav.org/wiki/Subsystem/radio_control#Spektrum
-->

<airframe name="Quadrotor Febris21">

  <firmware name="rotorcraft">
    <target name="ap" board="lisa_m_2.0">      
      <!-- baro board options for Lisa/M 2.0: BARO_BOARD_BMP085, BARO_MS5611_I2C, BARO_MS5611_SPI (default) -->
      <configure name="LISA_M_BARO" value="BARO_MS5611_SPI"/>
      <configure name="FLASH_MODE" value="DFU-UTIL"/>

      <!-- 光流传感器配置，模块接I2C1。（由于nps模拟环境不支持光流，所以光流配置必须写道ap中。） -->
      <module name="px4flow_i2c">
        <configure name="PX4FLOW_I2C_DEV" value="i2c1"/>
      </module>
      <module name="opticflow_hover"/>
    </target>

    <target name="nps" board="pc">
      <module name="fdm" type="jsbsim"/>
    </target>

    <module name="telemetry_transparent">    
      <configure name="MODEM_PORT" value="UART2"/>
      <configure name="MODEM_BAUD" value="B19200"/>
    </module>

    <module name="radio_control" type="spektrum">
      <define name="RADIO_MODE" value="RADIO_AUX1"/>
    </module>

    <module name="motor_mixing"/>
    <module name="actuators"     type="pwm">
      <define name="SERVO_HZ" value="400"/>
      <!--define name="USE_SERVOS_7AND8"/-->
    </module>

    <module name="imu"           type="aspirin_v2.2"/>    
    <module name="gps"           type="ubx_ucenter"/>
    <module name="stabilization" type="int_quat"/>
    <module name="ahrs"          type="int_cmpl_quat">
      <define name="AHRS_GRAVITY_HEURISTIC_FACTOR" value="30"/>
    </module>
    <module name="ins"/>
    
    <module name="geo_mag"/>
    <module name="air_data"/>

    <!--define name="KILL_ON_GROUND_DETECT" value="TRUE"/-->
  </firmware>

  <servos driver="Pwm">
    <servo name="FRONT"   no="0" min="1000" neutral="1100" max="1900"/>
    <servo name="BACK"    no="1" min="1000" neutral="1100" max="1900"/>
    <servo name="RIGHT"   no="2" min="1000" neutral="1100" max="1900"/>
    <servo name="LEFT"    no="3" min="1000" neutral="1100" max="1900"/>
  </servos>

  <commands>
    <axis name="ROLL"   failsafe_value="0"/>
    <axis name="PITCH"  failsafe_value="0"/>
    <axis name="YAW"    failsafe_value="0"/>
    <axis name="THRUST" failsafe_value="0"/>
  </commands>

  <section name="MIXING" prefix="MOTOR_MIXING_">
    <!-- front (CW), right (CCW), back (CW), left (CCW) -->
    <define name="TYPE" value="QUAD_PLUS"/>
  </section>

  <command_laws>
    <call fun="motor_mixing_run(autopilot_get_motors_on(),FALSE,values)"/>
    <set servo="FRONT" value="motor_mixing.commands[MOTOR_FRONT]"/>
    <set servo="RIGHT" value="motor_mixing.commands[MOTOR_RIGHT]"/>
    <set servo="BACK"  value="motor_mixing.commands[MOTOR_BACK]"/>
    <set servo="LEFT"  value="motor_mixing.commands[MOTOR_LEFT]"/>
  </command_laws>

  <section name="IMU" prefix="IMU_">
    <!-- 加速度计出厂值   
    <define name="ACCEL_X_NEUTRAL" value="11"/>
    <define name="ACCEL_Y_NEUTRAL" value="11"/>
    <define name="ACCEL_Z_NEUTRAL" value="-25"/>
    -->

    <!-- 加速度计校正后-中立点 -->    
    <define name="ACCEL_X_NEUTRAL" value="0"/>
    <define name="ACCEL_Y_NEUTRAL" value="-4"/>
    <define name="ACCEL_Z_NEUTRAL" value="127"/>
    <!-- 加速度计校正后-数值 -->
    <define name="ACCEL_X_SENS" value="4.912952628846816" integer="16"/>
    <define name="ACCEL_Y_SENS" value="4.887809196682819" integer="16"/>
    <define name="ACCEL_Z_SENS" value="4.889228798093371" integer="16"/>

    <!-- 罗盘出厂值-中立点 -->
    <define name="MAG_X_NEUTRAL" value="-179"/>
    <define name="MAG_Y_NEUTRAL" value="-21"/>
    <define name="MAG_Z_NEUTRAL" value="79"/>
    <!-- 罗盘出厂值-数值 -->
    <define name="MAG_X_SENS" value="4.17334785618" integer="16"/>
    <define name="MAG_Y_SENS" value="3.98885954135" integer="16"/>
    <define name="MAG_Z_SENS" value="4.40442339014" integer="16"/>

    <define name="BODY_TO_IMU_PHI"   value="0." unit="deg"/>
    <define name="BODY_TO_IMU_THETA" value="0." unit="deg"/>
    <define name="BODY_TO_IMU_PSI"   value="0." unit="deg"/>
  </section>

  <!-- 磁偏角出厂值 -->
  <section name="AHRS" prefix="AHRS_">
    <!-- values used if no GPS fix, on 3D fix is update by geo_mag module -->
    <!-- Toulouse -->
    <define name="H_X" value="0.513081"/>
    <define name="H_Y" value="-0.00242783"/>
    <define name="H_Z" value="0.858336"/>
  </section>

  <!-- 惯性导航默认设置 -->
  <section name="INS" prefix="INS_">
  </section>

  <!-- 姿态控制器（Attitude Controller）配置 -->
  <section name="STABILIZATION_ATTITUDE" prefix="STABILIZATION_ATTITUDE_">
    <!-- Setpoints（遥控输入限制） 
        表示最大倾角：
        横滚最大 ±45°
        俯仰最大 ±45°

        遥控杆打满时：
        Roll = 45°
        Pitch = 45°

        增大

        例如：
        SP_MAX_PHI   = 60
        SP_MAX_THETA = 60

        飞机更灵活。

        减小

        例如：
        SP_MAX_PHI   = 25
        SP_MAX_THETA = 25

        飞机更稳。

        适合：
        新手
        室内飞行
        测试
    -->
    <define name="SP_MAX_PHI"     value="45." unit="deg"/>
    <define name="SP_MAX_THETA"   value="45." unit="deg"/>
    <!-- 遥控器偏航（Yaw）摇杆打满时，允许的最大偏航角速度 -->
    <define name="SP_MAX_R"       value="90." unit="deg/s"/>
    <!-- Deadband（遥控死区）
        对应：
        参数	  通道
        A	      Roll
        E	      Pitch
        R	      Yaw

        表示：
        摇杆中心 ±250，范围内忽略输入。

        防止：
        遥控器抖动
        摇杆回中不准
    -->
    <define name="DEADBAND_A"     value="0"/>
    <define name="DEADBAND_E"     value="0"/>
    <define name="DEADBAND_R"     value="250"/>

    <!-- Reference（期望姿态响应）
        例如：
        REF_OMEGA_P = 400

        对应：
        Roll自然频率

        可以理解为：
        想让飞机响应多快

        数值越大：
        反应越快
        更灵敏

        数值越小：
        更柔和
        更稳定

        Roll
        REF_OMEGA_P = 400
        Pitch
        REF_OMEGA_Q = 400
        Yaw
        REF_OMEGA_R = 250

        REF_ZETA（阻尼）
        REF_ZETA_P = 0.85
        REF_ZETA_Q = 0.85
        REF_ZETA_R = 0.85

        控制：
        是否振荡

        经验值：
        Zeta	效果
        0.5	  快但容易过冲
        0.7	  较快
        0.85	官方推荐
        1.0	  最稳
    -->
    <define name="REF_OMEGA_P"  value="400" unit="deg/s"/>
    <define name="REF_ZETA_P"   value="0.85"/>
    <define name="REF_MAX_P"    value="400." unit="deg/s"/>
    <define name="REF_MAX_PDOT" value="RadOfDeg(8000.)"/>

    <define name="REF_OMEGA_Q"  value="400" unit="deg/s"/>
    <define name="REF_ZETA_Q"   value="0.85"/>
    <define name="REF_MAX_Q"    value="400." unit="deg/s"/>
    <define name="REF_MAX_QDOT" value="RadOfDeg(8000.)"/>

    <define name="REF_OMEGA_R"  value="250" unit="deg/s"/>
    <define name="REF_ZETA_R"   value="0.85"/>
    <define name="REF_MAX_R"    value="180." unit="deg/s"/>
    <define name="REF_MAX_RDOT" value="RadOfDeg(1800.)"/>

    <!-- 核心控制增益 PHI / THETA / PSI PID  
        P
        误差越大
        修正越强

        过大：振荡
        过小：发软

        D
        抑制振荡

        过大：
        电机抖动
        噪声放大

        I
        消除长期偏差

        例如：
        重心偏移
        风干扰
    -->
    <define name="PHI_PGAIN"  value="1000"/>
    <define name="PHI_DGAIN"  value="400"/>
    <define name="PHI_IGAIN"  value="200"/>

    <define name="THETA_PGAIN"  value="1000"/>
    <define name="THETA_DGAIN"  value="400"/>
    <define name="THETA_IGAIN"  value="200"/>

    <define name="PSI_PGAIN"  value="500"/>
    <define name="PSI_DGAIN"  value="300"/>
    <define name="PSI_IGAIN"  value="10"/>

    <!-- DDGAIN（前馈） 
        这是：
        Feed Forward
        不是 PID。

        作用：
        提前给控制量

        让飞机：
        更跟手
        更丝滑
    -->
    <define name="PHI_DDGAIN"   value="300"/>
    <define name="THETA_DDGAIN" value="300"/>
    <define name="PSI_DDGAIN"   value="300"/>
  </section>

  <!-- Paparazzi 对四旋翼的控制链路大致是：

      导航控制（Guidance）
              ↓
      姿态控制（Attitude）
              ↓
      角速度控制（Rate）
              ↓
      电机混控
              ↓
      电机

      因此：
      GUIDANCE_V
      负责 垂直方向（高度）控制

      而：
      GUIDANCE_H
      负责 水平方向（位置）控制
  -->
  <section name="GUIDANCE_V" prefix="GUIDANCE_V_">
    <!-- 高度控制P增益。
        作用：
        当前高度和目标高度差多少
        ↓
        决定增加多少油门

        例如：
        目标高度 10m
        实际高度 8m

        误差 = 2m

        KP越大：
        加油门越猛
    -->
    <define name="HOVER_KP"    value="150"/>
    <!-- 高度变化速度反馈。
        例如：
        正在快速上升
        KD会提前减小油门。

        作用：
        抑制过冲
    -->
    <define name="HOVER_KD"    value="80"/>
    <!-- 积分项。
        解决：
        长期漂高
        长期掉高
    -->
    <define name="HOVER_KI"    value="20"/>
    <!-- 预计悬停油门

        这里：
        0.5 = 50%

        意味着：
        油门50%
        ≈ 悬停

        例如：
        轻载四轴
        35%

        可以悬停

        则：
        0.35
        更合适。

        重载四轴
        65%

        悬停

        则：
        0.65
        更合理。

        如果设置不准：
        可能出现：
        自动起飞很猛
        自动降落很慢
        高度控制不稳
    -->
    <define name="NOMINAL_HOVER_THROTTLE" value="0.5"/>
    <!-- 允许自动学习悬停油门
        飞行过程中：
        实际悬停需要52%

        飞控会逐渐把：
        NOMINAL_HOVER_THROTTLE
        0.50
        ↓
        0.52
        进行修正。

        对于实验机：
        TRUE
        一般推荐保持开启。
    -->
    <define name="ADAPT_THROTTLE_ENABLED" value="TRUE"/>
  </section>

  <!-- GUIDANCE_H（水平导航）
      负责：
      GPS定位
      自动悬停
      自动返航
      航点飞行
  -->
  <section name="GUIDANCE_H" prefix="GUIDANCE_H_">
    <!-- 自动导航允许的最大倾角
        例如：
        飞机要向前飞

        飞控会让飞机俯仰：
        5°
        10°
        15°
        20°

        但不会超过：
        20°

        影响：

        小
        10°

        效果：
        慢
        稳

        大
        35°

        效果：
        快
        激进
    -->
    <define name="MAX_BANK" value="20" unit="deg"/>
    <!--
        表示：

        位置控制
        ↓
        先生成速度目标
        ↓
        再生成姿态目标

        属于：
        位置环
        →速度环
        →姿态环

        控制结构。

        这是官方推荐方式。
        一般不要改。
    -->
    <define name="USE_SPEED_REF" value="TRUE"/>
    <!-- 位置误差增益。
        例如：
        目标位置
        距离当前位置
        5m

        则：
        生成前进速度

        PGAIN越大：
        追目标更快

        但容易：
        来回摆动
    -->
    <define name="PGAIN" value="50"/>
    <!-- 速度阻尼 
        作用：
        减小冲过头
    -->
    <define name="DGAIN" value="100"/>
    <!-- 加速度反馈 
        用于：
        GPS
        IMU
        融合控制。

        作用：
        提高动态响应
    -->
    <define name="AGAIN" value="70"/>
    <!-- 积分项 
        解决：
        长期位置漂移

        例如：
        风一直吹
        飞机始终偏东。
        IGAIN会慢慢修正。
    -->
    <define name="IGAIN" value="20"/>
  </section>

  <section name="NAV">
    <define name="ARRIVED_AT_WAYPOINT" value="2" unit="m"/>
  </section>

  <section name="SIMULATOR" prefix="NPS_">
    <define name="ACTUATOR_NAMES"  value="front_motor, right_motor, back_motor, left_motor" type="string[]"/>
    <define name="JSBSIM_MODEL" value="simple_quad" type="string"/>
    <!-- mode switch on joystick channel 5 (axis numbering starting at zero) -->
    <define name="JS_AXIS_MODE" value="4"/>
  </section>

  <section name="AUTOPILOT">
    <define name="MODE_MANUAL" value="AP_MODE_ATTITUDE_DIRECT"/>
    <define name="MODE_AUTO1"  value="AP_MODE_HOVER_Z_HOLD"/>
    <define name="MODE_AUTO2"  value="AP_MODE_NAV"/>
  </section>

  <!-- 电池监测（Battery Monitoring）配置 
  
  -->
  <section name="BAT">
    <!-- 灾难性低电量 -->
    <define name="CATASTROPHIC_BAT_LEVEL" value="9.3" unit="V"/>
    <!-- 严重低电量 -->
    <define name="CRITIC_BAT_LEVEL" value="9.6" unit="V"/>
    <!-- 低电量警告 -->
    <define name="LOW_BAT_LEVEL" value="10.1" unit="V"/>
    <!-- 满电电压 -->
    <define name="MAX_BAT_LEVEL" value="12.4" unit="V"/>
    <!-- 满油门电流 -->
    <define name="MILLIAMP_AT_FULL_THROTTLE" value="30000"/>
  </section>

</airframe>
